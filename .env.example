# DEVELOPMENT ONLY — do not reuse these example credentials in production.
POSTGRES_USER=enjoylife
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=enjoylife
DATABASE_URL=postgres://enjoylife:dev_password_change_me@db:5432/enjoylife?sslmode=disable
API_PORT=8081
WEB_ORIGIN=http://localhost:3000
# Reserve for future secure admin auth. Empty disables the admin API entirely.
ADMIN_API_KEY=
# Development administrator created on API startup. Change before any public deployment.
ADMIN_EMAIL=admin@enjoylife.local
ADMIN_PASSWORD=dev_admin_change_me
# Opt-in only: configure fresh rotated payOS credentials in your private .env, never git.
# Live money transfers require a publicly reachable HTTPS webhook and reconciliation.
# Leave false for local CI/demo.
PAYMENT_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# OpenAI API key. Keep this only in .env; it is never exposed to the browser.
OPENAI_API_KEY=
# Optional: GPT-4.1 mini is a supported, lower-cost model for concise shopping assistance.
AI_MODEL=gpt-4.1-mini

# Optional DEV-ONLY design preview. Not production admin authentication.
ADMIN_PREVIEW_USER=
ADMIN_PREVIEW_PASSWORD=

# Local-only fixed admin/admin demo, disabled in production.
APP_ENV=development
GIN_MODE=debug
ENABLE_DEV_ADMIN=true

